{
  "name": "@rakazo/desktop",
  "productName": "Quant",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "pack": "pnpm --filter @rakazo/web build && pnpm build && pnpm build:server && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @rakazo/web build && pnpm build && pnpm build:server && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src apps/desktop/server",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @rakazo/web build && pnpm build && pnpm build:server && electron-builder --publish never",
    "build:server": "pnpm --filter @rakazo/db generate && node scripts/build-server.mjs"
  },
  "dependencies": {
    "@rakazo/contracts": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rakazo/ui-tokens": "workspace:*",
    "@types/pg": "8.23.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "ai.quant.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "server-dist",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      },
      {
        "from": "assets",
        "to": "tray",
        "filter": [
          "tray.png",
          "trayTemplate.png",
          "trayTemplate@2x.png"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": false,
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "executableName": "quant",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Quant-Ai-Assistant",
        "repo": "Quant-Core"
      }
    ]
  }
}
