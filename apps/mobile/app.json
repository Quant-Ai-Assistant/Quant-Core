{
  "expo": {
    "name": "Quant",
    "slug": "quant",
    "scheme": "rakazo",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Quant uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Quant turns your speech into messages during voice calls.",
          "microphonePermission": "Quant uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quant uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Quant uses the camera so you can attach photos to a bot message.",
          "microphonePermission": "Quant uses the microphone for voice calls with your bots."
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-quant-android",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Quant uses the microphone for voice calls with your bots."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.quantai.quant",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Quant uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Quant uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Quant connects to a self-hosted Quant server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.quantai.quant",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "url": "https://updates.invalid/api/mobile-updates/manifest",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "disableAntiBrickingMeasures": true
    }
  }
}
